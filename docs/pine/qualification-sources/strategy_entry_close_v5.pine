//@version=5
strategy("Entry Close Semantics Qualification Source", overlay=true, pyramiding=0)
length = input.int(20, "SMA Length", minval=2)
average = ta.sma(close, length)
longEntry = ta.crossover(close, average)
shortEntry = ta.crossunder(close, average)
closeLong = ta.crossunder(close, average * 0.99)
closeShort = ta.crossover(close, average * 1.01)
if longEntry
    strategy.entry("Long", strategy.long)
if shortEntry
    strategy.entry("Short", strategy.short)
if closeLong
    strategy.close("Long")
if closeShort
    strategy.close("Short")
