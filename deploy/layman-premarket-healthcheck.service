[Unit]
Description=Layman NOVA pre-market healthcheck
After=network-online.target layman-nova-signal-router.service nginx.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/layman-nova-signal-router/backend
Environment="PATH=/root/layman-nova-signal-router/backend/.venv/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/root/layman-nova-signal-router/backend/.venv/bin/python -m scripts.premarket_healthcheck
