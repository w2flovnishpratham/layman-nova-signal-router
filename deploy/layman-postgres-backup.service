[Unit]
Description=Layman NOVA PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=layman
Group=layman
Environment="LAYMAN_ENV_FILE=/etc/layman/layman.env"
ExecStart=/usr/local/sbin/layman-backup-postgres
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/layman
ReadWritePaths=/var/backups/layman/postgres
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
