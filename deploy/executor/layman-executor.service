[Unit]
Description=Layman NOVA Executor (per-user egress order relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=laymanexec
Group=laymanexec
WorkingDirectory=/opt/layman-executor/backend
EnvironmentFile=/etc/layman-executor/executor.env
Environment="LAYMAN_ENV_FILE=/etc/layman-executor/executor.env"
Environment="PATH=/opt/layman-executor/backend/.venv/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
UMask=0077
# Bind only to localhost; nginx terminates TLS and proxies to this port.
ExecStart=/opt/layman-executor/backend/.venv/bin/uvicorn app.executor_service.main:app --host ${EXECUTOR_BIND_HOST} --port ${EXECUTOR_PORT} --workers 1
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGINT

RuntimeDirectory=layman-executor
RuntimeDirectoryMode=0700
StateDirectory=layman-executor
StateDirectoryMode=0700
LogsDirectory=layman-executor
LogsDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/layman-executor /var/log/layman-executor /run/layman-executor

[Install]
WantedBy=multi-user.target
