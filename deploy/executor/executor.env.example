# Layman NOVA Executor environment (per droplet).
#
# Install to /etc/layman-executor/executor.env, owned by laymanexec:laymanexec,
# mode 0600. NEVER commit a real file. This .example carries placeholders only.
#
# Executor 001 -> reserved IP 64.225.87.19 -> Dhan Account 1 whitelist
# Executor 002 -> reserved IP 152.42.157.165 -> Dhan Account 2 whitelist

APP_ENV=production

# Identity. Must match the executor_code registered on the Hostinger main app.
EXECUTOR_CODE=EXECUTOR_001

# The DigitalOcean Reserved IP attached to this droplet. /egress-ip must equal it.
EXECUTOR_RESERVED_IP=64.225.87.19

# 32+ random characters, unique per executor. Must match the matching entry in
# the Hostinger EXECUTOR_SHARED_SECRETS_JSON map. Generate with: openssl rand -hex 32
EXECUTOR_SHARED_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS

# Real broker calls. Keep false until the controlled pilot moment, then set back.
EXECUTOR_REAL_ORDERS_ENABLED=false

# Public IP of the Hostinger main server (for firewall/allowlist documentation).
EXECUTOR_ALLOWED_MAIN_HOSTINGER_IP=REPLACE_WITH_HOSTINGER_PUBLIC_IP

# Local bind. nginx terminates TLS in front and proxies to this host:port.
EXECUTOR_BIND_HOST=127.0.0.1
EXECUTOR_PORT=8010

# Request handling.
EXECUTOR_REQUEST_TIMEOUT_SECONDS=10
EXECUTOR_TIMESTAMP_TOLERANCE_SECONDS=60
EXECUTOR_EGRESS_CHECK_URL=https://api.ipify.org?format=json

# Database for durable nonce replay receipts. Use the same Neon database as the
# main app, or a dedicated small database. Required so replays are rejected
# across restarts.
DATABASE_URL=postgresql+psycopg://layman:REPLACE_PASSWORD@REPLACE_HOST:5432/layman

# Dhan compatibility header (client-id alongside access-token).
DHAN_SEND_CLIENT_ID_HEADER=true
