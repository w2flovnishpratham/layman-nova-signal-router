APP_ENV=production

# Production loads /etc/layman/layman.env via systemd. Do not copy this file
# to backend/.env on a server.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002

BACKEND_PUBLIC_BASE_URL=https://layman-api.manyacare.com
FRONTEND_ORIGIN=https://layman.manyacare.com

DHAN_MODE=REAL
DHAN_READ_ONLY_REAL_DATA=true
PAPER_MODE_ENABLED=true
ENABLE_LIVE_ORDERS=false
UNIQUE_EGRESS_PER_USER_REQUIRED=true
EXECUTION_NODE_ROUTING_ENABLED=false
WEBHOOK_TRADING_ENABLED=false
WEBHOOK_HMAC_REQUIRED=true
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=60
WEBHOOK_ALLOW_LEGACY_AUTH_LOCAL=false
REQUIRE_SIGNAL_ID_LIVE=true
WORKER_ROLE=web
ENABLE_PAPER_WORKERS=false
PAPER_WORKER_CONCURRENCY=1
WORKER_JOB_LOCK_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_RETRY_BASE_SECONDS=2
PAPER_QUEUE_INLINE_LOCAL=false
ENABLE_TRADING_WORKERS=false
TRADING_WORKER_DISTRIBUTED_LOCK_ENABLED=false

TOKEN_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
SESSION_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SESSION_TOKEN_TTL_SECONDS=43200

AUTH_REQUIRED=true
DATABASE_URL=postgresql+psycopg://layman:REPLACE_PASSWORD@127.0.0.1:5432/layman
AUTH_DATABASE_URL=
ADMIN_EMAILS=REPLACE_WITH_EXPLICIT_ALLOWED_EMAILS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://layman-api.manyacare.com/api/auth/google/callback
AUTH_COOKIE_TTL_SECONDS=604800
CSRF_COOKIE_NAME=layman_csrf
CSRF_HEADER_NAME=X-CSRF-Token

REQUIRE_MARKET_HOURS=true
REQUIRE_FRESH_EXPIRY_LIVE=true

AUTO_RESOLVE_SECURITY_ID=true
REQUIRE_INSTRUMENT_MASTER_VALIDATION_LIVE=true
DHAN_SCRIP_MASTER_PATH=data/dhan_scrip_master.csv
ALLOW_DEFAULT_SECURITY_ID=false
DEFAULT_SECURITY_ID=

# Production runtime data must be outside the repository and owned by the
# backend service account with mode 0700.
RUNTIME_STATE_DIR=/var/lib/layman/state
RUNTIME_LOG_DIR=/var/lib/layman/logs

DEBUG_ENABLED=false
MARKET_CLOSED_DEBUG=false
FORCE_ALLOW_ORDER_WHEN_MARKET_CLOSED=false
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
FREE_MAX_ACTIVE_PAPER_STRATEGIES=1
RELAY_SHARED_SECRET=
RELAY_ALLOWED_STRATEGIES=SUPERTREND_FLIP
RELAY_ENABLED=false
LIVE_PILOT_ENABLED=false
LIVE_PILOT_ALLOWED_STRATEGIES=SUPERTREND_FLIP
LIVE_ORDER_DRY_RUN_ONLY=true
ENABLE_LIVE_PILOT_WORKERS=false
EXECUTOR_SHARED_SECRETS_JSON={}
EXECUTOR_REQUEST_TIMEOUT_SECONDS=10
EXECUTOR_TIMESTAMP_TOLERANCE_SECONDS=60
EXECUTOR_CODE=
EXECUTOR_RESERVED_IP=
EXECUTOR_SHARED_SECRET=
EXECUTOR_EGRESS_CHECK_URL=https://api.ipify.org?format=json
EXECUTOR_REAL_ORDERS_ENABLED=false
DHAN_API_MAX_REQUESTS_PER_SECOND=4
DHAN_API_BURST=4
DHAN_API_MAX_RETRY_AFTER_SECONDS=60
