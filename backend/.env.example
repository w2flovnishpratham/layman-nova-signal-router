# =============================================================================
# NOVA / Layman Signal Router — backend .env (LOCAL DEV example)
# Copy to backend/.env and fill in. NEVER commit a real .env.
# =============================================================================

APP_ENV=local

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Where the API is reachable + which frontend origin may call it.
BACKEND_PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_URL is where users land after Google login (defaults to FRONTEND_ORIGIN).
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Multi-user auth (Google OAuth)
# ---------------------------------------------------------------------------
# In local dev you can leave AUTH_REQUIRED=false to use the deterministic dev
# user (the existing single-user paper flow keeps working with no login).
AUTH_REQUIRED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Comma-separated. ONLY controls /api/admin/*; never blocks normal login.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Neon PostgreSQL (multi-user database). Provided via env ONLY — never hardcode.
# Format: postgresql://user:password@host/db?sslmode=require&channel_binding=require
# The backend auto-normalizes postgresql:// -> postgresql+psycopg:// and keeps
# all query params (sslmode, channel_binding).
# Leave empty in pure local paper mode (no DB) when AUTH_REQUIRED=false.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Secrets / encryption
# ---------------------------------------------------------------------------
# APP_SECRET_KEY signs the session cookie (>= 32 random chars in prod).
# Falls back to SESSION_TOKEN_SECRET if unset.
APP_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
SESSION_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SESSION_TOKEN_TTL_SECONDS=43200

# Per-user credential encryption (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Falls back to TOKEN_ENCRYPTION_KEY if unset. REQUIRED in production.
CREDENTIAL_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
CREDENTIAL_VAULT_BACKEND=db

# Session cookie flags. In local http dev set SESSION_COOKIE_SECURE=false.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Dhan / live-mode safety. Defaults are SAFE: no real orders.
# ---------------------------------------------------------------------------
DHAN_MODE=MOCK
DHAN_READ_ONLY_REAL_DATA=true
PAPER_MODE_ENABLED=true
ENABLE_LIVE_ORDERS=false

# ---------------------------------------------------------------------------
# Shared market-data account (global live data for ALL paper users).
# A DEDICATED, FUNDS-EMPTY Dhan account with an active Data API plan and TOTP
# enabled (Dhan Web > DhanHQ Trading APIs > Setup TOTP). When enabled, paper
# mode needs no per-user Dhan token; the access token auto-refreshes daily.
# Keep these secret — anyone with them can authenticate as that account.
# ---------------------------------------------------------------------------
DHAN_SHARED_DATA_ENABLED=false
DHAN_SHARED_CLIENT_ID=
DHAN_SHARED_PIN=
DHAN_SHARED_TOTP_SECRET=
EXECUTION_NODE_ROUTING_ENABLED=false
STRATEGY_WEBHOOK_SECRET=
WEBHOOK_TRADING_ENABLED=false
WEBHOOK_HMAC_REQUIRED=true

REQUIRE_MARKET_HOURS=false
AUTO_RESOLVE_SECURITY_ID=true
DHAN_SCRIP_MASTER_PATH=data/dhan_scrip_master.csv
ALLOW_DEFAULT_SECURITY_ID=false
DEFAULT_SECURITY_ID=

RUNTIME_STATE_DIR=runtime_state
RUNTIME_LOG_DIR=runtime_logs

DEBUG_ENABLED=false
MARKET_CLOSED_DEBUG=false
FORCE_ALLOW_ORDER_WHEN_MARKET_CLOSED=false
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
DHAN_API_MAX_REQUESTS_PER_SECOND=4
DHAN_API_BURST=4
DHAN_API_MAX_RETRY_AFTER_SECONDS=60
