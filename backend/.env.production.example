# =============================================================================
# NOVA / Layman Signal Router — backend .env (PRODUCTION example)
# Copy to backend/.env on the VPS and fill in REAL values. NEVER commit.
# The app FAILS LOUDLY on startup if required secrets are missing in production.
# =============================================================================

APP_ENV=production

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

BACKEND_PUBLIC_BASE_URL=https://layman-api.manyacare.com
FRONTEND_ORIGIN=https://layman.manyacare.com
FRONTEND_URL=https://layman.manyacare.com

# ---------------------------------------------------------------------------
# Google OAuth — required when AUTH_REQUIRED=true
# ---------------------------------------------------------------------------
AUTH_REQUIRED=true
GOOGLE_CLIENT_ID=__set_in_secret_manager__
GOOGLE_CLIENT_SECRET=__set_in_secret_manager__
GOOGLE_REDIRECT_URI=https://layman-api.manyacare.com/api/auth/google/callback
# Admins for /api/admin/* only. Does NOT restrict normal login.
ADMIN_EMAILS=you@yourdomain.com

# ---------------------------------------------------------------------------
# Neon PostgreSQL — REQUIRED. Provide via secret manager / env, never in code.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require

# ---------------------------------------------------------------------------
# Secrets — REQUIRED. Generate fresh, store in your secret manager.
#   APP_SECRET_KEY:           python -c "import secrets;print(secrets.token_urlsafe(48))"
#   CREDENTIAL_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
APP_SECRET_KEY=__set_in_secret_manager__
SESSION_TOKEN_SECRET=__set_in_secret_manager__
SESSION_TOKEN_TTL_SECONDS=43200
CREDENTIAL_ENCRYPTION_KEY=__set_in_secret_manager__
TOKEN_ENCRYPTION_KEY=__set_in_secret_manager__
CREDENTIAL_VAULT_BACKEND=db

# Secure cookies over HTTPS. If frontend + API are on different sites, use
# SESSION_COOKIE_SAMESITE=none (requires SECURE=true).
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Dhan / live-mode safety. Keep real orders OFF until you have verified the
# per-user safety checklist for a given user.
# ---------------------------------------------------------------------------
DHAN_MODE=REAL
DHAN_READ_ONLY_REAL_DATA=true
PAPER_MODE_ENABLED=true
ENABLE_LIVE_ORDERS=false
EXECUTION_NODE_ROUTING_ENABLED=false
AWS_PROXY_SLOTS_ENABLED=true
AWS_PROXY_HOST=13.203.58.220
AWS_PROXY_SHARED_PASSWORD=REPLACE_WITH_SECRET
AWS_PROXY_SLOT_1_PASSWORD=
AWS_PROXY_SLOT_2_PASSWORD=
AWS_PROXY_SLOT_3_PASSWORD=
AWS_PROXY_SLOT_4_PASSWORD=
AWS_PROXY_SLOT_5_PASSWORD=
STRATEGY_WEBHOOK_SECRET=
WEBHOOK_TRADING_ENABLED=false
WEBHOOK_HMAC_REQUIRED=true

# ---------------------------------------------------------------------------
# Payments / subscriptions (Razorpay) — required before ENABLE_LIVE_ORDERS=true
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=__set_in_secret_manager__
RAZORPAY_KEY_SECRET=__set_in_secret_manager__
RAZORPAY_WEBHOOK_SECRET=__set_in_secret_manager__
RAZORPAY_PLAN_PREMIUM_MONTHLY=__set_in_secret_manager__
PAYMENT_SIMULATION_ENABLED=false

REQUIRE_MARKET_HOURS=true
AUTO_RESOLVE_SECURITY_ID=true
DHAN_SCRIP_MASTER_PATH=data/dhan_scrip_master.csv
ALLOW_DEFAULT_SECURITY_ID=false
DEFAULT_SECURITY_ID=

RUNTIME_STATE_DIR=runtime_state
RUNTIME_LOG_DIR=runtime_logs

DEBUG_ENABLED=false
MARKET_CLOSED_DEBUG=false
FORCE_ALLOW_ORDER_WHEN_MARKET_CLOSED=false
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
DHAN_API_MAX_REQUESTS_PER_SECOND=4
DHAN_API_BURST=4
DHAN_API_MAX_RETRY_AFTER_SECONDS=60
