APP_ENV=live_route_test

# This template is for controlled route testing only. Production configuration
# belongs in /etc/layman/layman.env and live orders remain disabled.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
WEBHOOK_TRADING_ENABLED=true
WEBHOOK_HMAC_REQUIRED=true
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=60
WEBHOOK_ALLOW_LEGACY_AUTH_LOCAL=false
REQUIRE_SIGNAL_ID_LIVE=true
WORKER_ROLE=web
ENABLE_PAPER_WORKERS=false
PAPER_WORKER_CONCURRENCY=1
WORKER_JOB_LOCK_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_RETRY_BASE_SECONDS=2
PAPER_QUEUE_INLINE_LOCAL=false
ENABLE_TRADING_WORKERS=false
TRADING_WORKER_DISTRIBUTED_LOCK_ENABLED=false

PUBLIC_WEBHOOK_BASE_URL=https://REPLACE.ngrok-free.app
PUBLIC_TRADINGVIEW_WEBHOOK_URL=https://REPLACE.ngrok-free.app/webhook/tradingview

DHAN_MODE=REAL
ENABLE_LIVE_ORDERS=false
RELAY_SHARED_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
RELAY_ALLOWED_STRATEGIES=SUPERTREND_FLIP
RELAY_ENABLED=false
LIVE_PILOT_ENABLED=false
LIVE_PILOT_ALLOWED_STRATEGIES=SUPERTREND_FLIP
LIVE_ORDER_DRY_RUN_ONLY=true
ENABLE_LIVE_PILOT_WORKERS=false
# Per-executor HMAC secrets, keyed by executor code. Each value must match the
# EXECUTOR_SHARED_SECRET on the matching droplet. Example for the two-account pilot:
# EXECUTOR_SHARED_SECRETS_JSON={"EXECUTOR_001":"<secret-001-32+>","EXECUTOR_002":"<secret-002-32+>"}
EXECUTOR_SHARED_SECRETS_JSON={}
EXECUTOR_REQUEST_TIMEOUT_SECONDS=10
EXECUTOR_TIMESTAMP_TOLERANCE_SECONDS=60
EXECUTOR_REAL_ORDERS_ENABLED=false
FREE_MAX_ACTIVE_PAPER_STRATEGIES=1
UNIQUE_EGRESS_PER_USER_REQUIRED=true
EXECUTION_NODE_ROUTING_ENABLED=false

# Use external runtime directories on any server. Local developers may
# override these with temporary paths outside a synced project folder.
RUNTIME_STATE_DIR=/var/lib/layman/state
RUNTIME_LOG_DIR=/var/lib/layman/logs

DATABASE_URL=postgresql+psycopg://layman:REPLACE_PASSWORD@REPLACE_HOST:5432/layman
AUTH_REQUIRED=true
ADMIN_EMAILS=REPLACE_WITH_EXPLICIT_ALLOWED_EMAILS
GOOGLE_CLIENT_ID=REPLACE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://layman-api.manyacare.com/api/auth/google/callback

DHAN_CLIENT_ID=REPLACE_DHAN_CLIENT_ID
DHAN_ACCESS_TOKEN=REPLACE_DHAN_ACCESS_TOKEN

MAX_QTY_PER_ORDER=1
MAX_TRADES_PER_DAY=1
DAILY_LOSS_LIMIT=500
ALLOW_ENTRY=true
ALLOW_EXIT=true
EMERGENCY_STOP=false
GLOBAL_KILL_SWITCH=false
GLOBAL_KILL_SWITCH_BLOCKS_EXITS=false

DEFAULT_STRATEGY_CODE=TRADINGVIEW_NIFTY_V1
DEFAULT_PRODUCT_TYPE=INTRADAY
DEFAULT_ORDER_TYPE=MARKET
DEFAULT_EXCHANGE_SEGMENT=NSE_FNO
QTY_MODE=ABSOLUTE

REQUIRE_MARKET_HOURS=true
REQUIRE_INSTRUMENT_MASTER_VALIDATION_LIVE=true
REQUIRE_FRESH_EXPIRY_LIVE=true
ALLOW_ONLY_NIFTY=true
ALLOW_ONLY_INTRADAY=true
BLOCK_DUPLICATE_SIGNALS=true
