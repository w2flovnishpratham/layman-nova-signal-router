APP_ENV=live_route_test

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
WEBHOOK_TRADING_ENABLED=true
WEBHOOK_HMAC_REQUIRED=true

PUBLIC_WEBHOOK_BASE_URL=https://REPLACE.ngrok-free.app
PUBLIC_TRADINGVIEW_WEBHOOK_URL=https://REPLACE.ngrok-free.app/webhook/tradingview

DHAN_MODE=REAL
ENABLE_LIVE_ORDERS=false
UNIQUE_EGRESS_PER_USER_REQUIRED=true
EXECUTION_NODE_ROUTING_ENABLED=false

DATABASE_URL=postgresql+psycopg://layman:REPLACE_PASSWORD@REPLACE_HOST:5432/layman
AUTH_REQUIRED=true
ADMIN_EMAILS=w2f.lovnish@gmail.com
GOOGLE_CLIENT_ID=REPLACE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://layman-api.manyacare.com/api/auth/google/callback

DHAN_CLIENT_ID=REPLACE_DHAN_CLIENT_ID
DHAN_ACCESS_TOKEN=REPLACE_DHAN_ACCESS_TOKEN

MAX_QTY_PER_ORDER=1
MAX_TRADES_PER_DAY=1
DAILY_LOSS_LIMIT=500
ALLOW_ENTRY=true
ALLOW_EXIT=true
EMERGENCY_STOP=false
GLOBAL_KILL_SWITCH=false
GLOBAL_KILL_SWITCH_BLOCKS_EXITS=false

DEFAULT_STRATEGY_CODE=TRADINGVIEW_NIFTY_V1
DEFAULT_PRODUCT_TYPE=INTRADAY
DEFAULT_ORDER_TYPE=MARKET
DEFAULT_EXCHANGE_SEGMENT=NSE_FNO
QTY_MODE=ABSOLUTE

REQUIRE_MARKET_HOURS=true
ALLOW_ONLY_NIFTY=true
ALLOW_ONLY_INTRADAY=true
BLOCK_DUPLICATE_SIGNALS=true
